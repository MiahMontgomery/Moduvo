# Environment variables for Moduvo Platform production deployment
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@your-postgres-host:5432/moduvo_production

# Email Configuration (Migadu)
SMTP_HOST=smtp.migadu.com
SMTP_PORT=587
SMTP_USER=quotes@moduvo.to
SMTP_PASS=your_migadu_password
FROM_EMAIL=quotes@moduvo.to

# Session Security
SESSION_SECRET=your_secure_random_session_secret_here_make_it_long_and_random

# Application Settings
NODE_ENV=production
PORT=3000

# Object Storage (Google Cloud Storage)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GCS_BUCKET=moduvo-assets
PRIVATE_OBJECT_DIR=/moduvo-private
PUBLIC_OBJECT_SEARCH_PATHS=/moduvo-public

# Optional: Analytics and Monitoring
# GOOGLE_ANALYTICS_ID=GA_TRACKING_ID
# SENTRY_DSN=https://your-sentry-dsn

# Domain Configuration (for CORS and security)
ALLOWED_ORIGINS=https://moduvo.to,https://www.moduvo.to

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100