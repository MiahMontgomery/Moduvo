NODE_ENV=production
PORT=8000
DATABASE_URL=postgresql://moduvo:STRONG_PASSWORD@127.0.0.1:5432/moduvo
CORS_ORIGIN=https://moduvo.to,https://www.moduvo.to
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM
