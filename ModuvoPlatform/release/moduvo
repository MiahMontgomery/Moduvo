/opt/moduvo/logs/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 644 moduvo moduvo
    sharedscripts
    postrotate
        systemctl reload moduvo.service > /dev/null 2>&1 || true
    endscript
}

/var/log/nginx/*moduvo*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 644 www-data www-data
    sharedscripts
    postrotate
        systemctl reload nginx > /dev/null 2>&1 || true
    endscript
}